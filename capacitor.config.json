{
  "appId": "de.almaz.weltgeschichte",
  "appName": "Weltgeschichte",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#020814",
    "scheme": "Weltgeschichte"
  },
  "android": {
    "backgroundColor": "#020814",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 300,
      "backgroundColor": "#020814",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": false
    }
  },
  "backgroundColor": "#020814"
}
