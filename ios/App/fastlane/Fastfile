# Signiert die App mit einem App-Store-Connect-API-Schlüssel und lädt sie hoch.
# Wird vom Workflow .github/workflows/ios.yml aufgerufen; alle Werte kommen aus Umgebungsvariablen.
# Lane "prepare": Schlüsselbund, Zertifikat, Profil, Projekt auf manuelle Signierung.
# Lane "upload":  Archiv bauen und nach App Store Connect hochladen.

require "json"
require "shellwords"

default_platform(:ios)

APP_ID = "de.almaz.weltgeschichte"

def api_key_from_env
  app_store_connect_api_key(
    key_id: ENV.fetch("KEY_ID"),
    issuer_id: ENV.fetch("ISSUER_ID"),
    key_filepath: ENV.fetch("KEY_PATH"),
    in_house: false
  )
end

def summary(title, text)
  return unless ENV["GITHUB_STEP_SUMMARY"]
  File.open(ENV["GITHUB_STEP_SUMMARY"], "a") { |f| f.puts("## #{title}", "", text) }
end

# Liest die Eckdaten eines Provisioning-Profils direkt aus der Datei.
# Xcode findet ein Profil nur, wenn dessen TeamIdentifier zum Build-Setting
# DEVELOPMENT_TEAM passt - deshalb ist das Profil hier die verlaessliche Quelle.
def profile_info(path)
  plist_path = "#{path}.plist"
  system("security cms -D -i #{path.shellescape} > #{plist_path.shellescape} 2>/dev/null")
  UI.user_error!("Provisioning-Profil konnte nicht gelesen werden: #{path}") unless File.size?(plist_path)
  read = lambda do |key|
    `/usr/libexec/PlistBuddy -c "Print #{key}" #{plist_path.shellescape} 2>/dev/null`.strip
  end
  info = {
    name: read.call("Name"),
    uuid: read.call("UUID"),
    team_id: read.call("TeamIdentifier:0"),
    expires: read.call("ExpirationDate")
  }
  UI.user_error!("Provisioning-Profil enthaelt keine UUID oder Team-ID: #{path}") if info[:uuid].empty? || info[:team_id].empty?
  info
end

platform :ios do
  desc "Zertifikat und Profil beschaffen, Projekt auf manuelle Signierung stellen"
  lane :prepare do
    secret_team_id = ENV["TEAM_ID"].to_s.strip
    certs_dir     = File.expand_path(ENV.fetch("CERTS_DIR"))
    out_dir       = File.expand_path(ENV.fetch("OUT_DIR"))
    keychain      = "weltgeschichte-ci"
    keychain_pw   = ENV.fetch("KEYCHAIN_PASSWORD")
    keychain_path = File.expand_path("~/Library/Keychains/#{keychain}-db")

    FileUtils.mkdir_p(certs_dir)
    FileUtils.mkdir_p(out_dir)
    api_key = api_key_from_env

    create_keychain(
      name: keychain,
      password: keychain_pw,
      default_keychain: true,
      unlock: true,
      timeout: 0,
      lock_when_sleeps: false,
      add_to_search_list: true
    )

    # Vorhandenes Zertifikat (aus dem Repository entschlüsselt) wiederverwenden, sonst neu erzeugen.
    begin
      get_certificates(
        api_key: api_key,
        development: false,
        generate_apple_certs: true,
        output_path: certs_dir,
        keychain_path: keychain_path,
        keychain_password: keychain_pw,
        platform: "ios"
      )
    rescue => e
      if e.message.include?("maximum number")
        msg = "Apple erlaubt nur wenige Distribution-Zertifikate pro Team und das Limit ist erreicht. " \
              "Loesung: developer.apple.com -> Account -> Certificates -> ein altes Apple-Distribution-Zertifikat auswaehlen -> Revoke. " \
              "Danach den Workflow iOS App erneut starten. Bereits veroeffentlichte Apps sind davon nicht betroffen."
        summary("Zertifikat-Limit erreicht", msg)
        UI.user_error!(msg)
      end
      raise
    end

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: APP_ID,
      development: false,
      force: true,
      output_path: out_dir,
      filename: "AppStore.mobileprovision",
      platform: "ios"
    )
    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
    info = profile_info(profile_path)
    profile_name = info[:name]
    profile_uuid = info[:uuid]
    team_id = info[:team_id]

    UI.message("Profil:      #{profile_name}")
    UI.message("UUID:        #{profile_uuid}")
    UI.message("Team (Profil): #{team_id}")
    UI.message("Team (Secret): #{secret_team_id.empty? ? '(nicht gesetzt)' : secret_team_id}")
    UI.message("Gueltig bis: #{info[:expires]}")
    UI.message("Signieridentitaeten im Schluesselbund:")
    UI.message(`security find-identity -v -p codesigning 2>&1`)

    if !secret_team_id.empty? && secret_team_id != team_id
      summary("Hinweis zur Team-ID",
              "Das Secret APPLE_TEAM_ID (#{secret_team_id}) weicht von der Team-ID des Apple-Kontos (#{team_id}) ab. " \
              "Gebaut wird mit #{team_id}. Bitte das Secret bei Gelegenheit korrigieren oder loeschen.")
      UI.important("APPLE_TEAM_ID (#{secret_team_id}) passt nicht zum Apple-Konto (#{team_id}); es wird #{team_id} verwendet.")
    end

    # Profil an beiden Orten ablegen, die Xcode kennt (vor und ab Xcode 16).
    [
      File.expand_path("~/Library/MobileDevice/Provisioning Profiles"),
      File.expand_path("~/Library/Developer/Xcode/UserData/Provisioning Profiles")
    ].each do |dir|
      FileUtils.mkdir_p(dir)
      FileUtils.cp(profile_path, File.join(dir, "#{profile_uuid}.mobileprovision"))
      UI.message("Profil installiert: #{dir}")
    end

    update_code_signing_settings(
      path: "App.xcodeproj",
      targets: ["App"],
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_uuid,
      bundle_identifier: APP_ID
    )

    File.write(File.join(out_dir, "signing.json"),
               JSON.pretty_generate("team_id" => team_id, "profile_name" => profile_name, "profile_uuid" => profile_uuid))
  end

  desc "Archiv bauen und nach App Store Connect hochladen"
  lane :upload do
    build_number = ENV.fetch("BUILD_NUMBER")
    out_dir      = File.expand_path(ENV.fetch("OUT_DIR"))
    signing      = JSON.parse(File.read(File.join(out_dir, "signing.json")))
    team_id      = signing.fetch("team_id")
    profile_uuid = signing.fetch("profile_uuid")
    api_key = api_key_from_env

    # Profil ueber die UUID ansprechen: eindeutig und unabhaengig vom Anzeigenamen.
    xcargs = [
      "CURRENT_PROJECT_VERSION=#{build_number}",
      "DEVELOPMENT_TEAM=#{team_id}",
      "CODE_SIGN_STYLE=Manual",
      "CODE_SIGN_IDENTITY='Apple Distribution'",
      "PROVISIONING_PROFILE_SPECIFIER=#{profile_uuid}"
    ].join(" ")

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: out_dir,
      output_name: "Weltgeschichte.ipa",
      xcargs: xcargs,
      export_options: {
        provisioningProfiles: { APP_ID => profile_uuid },
        signingStyle: "manual",
        teamID: team_id,
        uploadSymbols: true
      }
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: File.join(out_dir, "Weltgeschichte.ipa"),
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )

    summary("Upload nach App Store Connect abgeschlossen",
            "Build #{build_number} erscheint in 10 bis 30 Minuten unter TestFlight bzw. bei der Build-Auswahl der Version.")
  end
end
